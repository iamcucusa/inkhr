#!/bin/sh
# Checks the branch name and every outgoing commit message, catching commits
# made before the hooks were switched on.
set -e

node tools/commit-rules/check-branch.mjs "$(git rev-parse --abbrev-ref HEAD)"

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
empty=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$empty" ] && continue
  if [ "$remote_sha" = "$empty" ]; then
    # A branch the remote does not have yet: check what no remote holds.
    node tools/commit-rules/check-range.mjs "$local_sha" --not --remotes
  else
    node tools/commit-rules/check-range.mjs "$remote_sha..$local_sha"
  fi
done

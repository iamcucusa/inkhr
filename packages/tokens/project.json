{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tokens",
  "sourceRoot": "packages/tokens/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/build.mjs",
        "{projectRoot}/covered-types.mjs"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node build.mjs",
        "cwd": "packages/tokens"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/check.mjs",
        "{projectRoot}/terrazzo.config.mjs",
        "{projectRoot}/lint/**/*",
        "{projectRoot}/covered-types.mjs"
      ],
      "options": {
        "command": "node check.mjs",
        "cwd": "packages/tokens"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/build.mjs",
        "{projectRoot}/covered-types.mjs",
        "{projectRoot}/tsconfig.json"
      ],
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/tokens"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/build.mjs",
        "{projectRoot}/covered-types.mjs",
        "{projectRoot}/check.mjs",
        "{projectRoot}/terrazzo.config.mjs",
        "{projectRoot}/lint/**/*",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/vitest.config.mts",
        "{workspaceRoot}/tools/name-check/**/*",
        "{workspaceRoot}/.claude/skills/inkhr/rules/**/*"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "packages/tokens"
      }
    }
  }
}

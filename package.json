{
  "name": "inkhr",
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true; node tools/commit-rules/init-local.mjs",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "test": "vitest run",
    "check:names": "node tools/name-check/check-names.mjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "{DESIGN,GAPS,AGENTS}.md": "node tools/name-check/check-names.mjs",
    "packages/tokens/src/**/*.json": [
      "node packages/tokens/check.mjs",
      "node tools/name-check/check-names.mjs"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@terrazzo/cli": "2.7.1",
    "eslint": "9.39.5",
    "lint-staged": "17.5.1",
    "nx": "23.2.1",
    "prettier": "3.9.7",
    "style-dictionary": "5.5.4",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
